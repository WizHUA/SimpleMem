# Copy this file to .env for local development. Process environment values win.
MEMORY_DB_PATH=data/memory.sqlite3
MEMORY_LOCAL_TENANT=local
MEMORY_LOCAL_OWNER=demo
# Local mode has one fixed principal and should bind to 127.0.0.1 only.
MEMORY_ALLOWED_ORIGINS=
# Optional model; missing configuration raises 503 for extraction/answering.
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_NAME=
MEMORY_MODEL_API_KEY=
MEMORY_MODEL_TIMEOUT=90
MEMORY_MODEL_MAX_TOKENS=4096
# GLM example:
# MEMORY_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MEMORY_MODEL_NAME=glm-5.3
