# Copy this file to .env for local development. Process environment values win.
MEMORY_DB_PATH=data/memory.sqlite3
MEMORY_LOCAL_TENANT=local
MEMORY_LOCAL_OWNER=demo
MEMORY_DEPLOYMENT_MODE=local
# Production requires at least 32 characters; never put this key in a VITE_* variable.
MEMORY_API_KEY=
# Local mode has one fixed principal and should bind to 127.0.0.1 only.
MEMORY_ALLOWED_ORIGINS=
# Optional model; missing configuration raises 503 for extraction/answering.
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_NAME=
MEMORY_MODEL_API_KEY=
MEMORY_MODEL_TIMEOUT=90
MEMORY_MODEL_MAX_TOKENS=4096
# Reuse only identical authorized context after fresh retrieval; no semantic answer cache.
MEMORY_ACCELERATION_ENABLED=true
MEMORY_INFERENCE_CACHE_TTL=60
MEMORY_INFERENCE_CACHE_ENTRIES=128
# Periodic extraction/maintenance for the configured local principal; 0 disables the worker.
MEMORY_MAINTENANCE_INTERVAL=300
# Bump when an embedding provider changes weights behind an unchanged model name.
MEMORY_EMBEDDING_REVISION=1
# Optional independent embedding service; leave all empty for explicit lexical baseline.
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_NAME=
MEMORY_EMBEDDING_API_KEY=
# DeepSeek example (keep the key in the private .env only):
# MEMORY_MODEL_BASE_URL=https://api.deepseek.com
# MEMORY_MODEL_NAME=deepseek-flash
# GLM example:
# MEMORY_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MEMORY_MODEL_NAME=glm-5.3
